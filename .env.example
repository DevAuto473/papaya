# انسخ هذا الملف إلى .env واملأه. لا ترفعه لأي مكان ولا ترسله لأحد.
TELEGRAM_BOT_TOKEN=paste-your-real-token-here
PAPAYA_ADMIN_CHAT_ID=0000000000
PAPAYA_ACCOUNTS=papaya01,papaya02,papaya03,papaya04
# كل كم دقيقة يفحص (الافتراضي 30)
PAPAYA_INTERVAL_MIN=30

# GitHub Actions standby (see papaya/standby.py): any long random string, the SAME value as the
# repo secret PAPAYA_STATE_KEY. Make one with:  openssl rand -hex 32
PAPAYA_STATE_KEY=
